new file mode 100644
index 0000000..a36ada6
--- /dev/null
+++ b/port/web/src/main/java/mindustry/web/Shims.java
@@ -0,0 +1,61 @@
+package mindustry.web;
+
+import java.net.*;
+
+/** Replacements for JDK methods missing from the browser class library (see {@link WebPlugin}). */
+public class Shims{
+    public static boolean isAnonymousClass(Class<?> type){
+        String name = type.getName();
+        int i = name.lastIndexOf('$');
+        if(i < 0 || i == name.length() - 1) return false;
+        for(int j = i + 1; j < name.length(); j++){
+            if(!Character.isDigit(name.charAt(j))) return false;
+        }
+        return true;
+    }
+
+    public static URL getResource(Class<?> type, String name){
+        return null;
+    }
+
+    /** Memory mapping doesn't exist here; callers fall back to reading the file. */
+    public static java.nio.ByteBuffer map(arc.files.Fi file){
+        throw new arc.util.ArcRuntimeException("Cannot map files in the browser: " + file);
+    }
+
+    public static long maxMemory(Runtime runtime){
+        return 2048L * 1024 * 1024;
+    }
+
+    public static void sleep(long ms, int nanos) throws InterruptedException{
+        Thread.sleep(ms + (nanos >= 500_000 ? 1 : 0));
+    }
+
+    /** Logged errors carry the JS stack of each cause, since the Java one is empty here. */
+    public static void printStackTrace(Throwable e, java.io.PrintWriter out){
+        out.print(getStackTrace(e));
+        out.flush();
+    }
+
+    public static String getStackTrace(Throwable e){
+        java.io.StringWriter out = new java.io.StringWriter();
+        e.printStackTrace(new java.io.PrintWriter(out));
+        for(Throwable c = e; c != null; c = c.getCause()){
+            String stack = WebHost.jsStack(c);
+            if(!stack.isEmpty()) out.append("\n--- ").append(String.valueOf(c)).append("\n").append(stack);
+        }
+        return out.toString();
+    }
+
+    public static long inflaterSkip(java.io.InputStream in, long n) throws java.io.IOException{
+        if(n < 0) throw new IllegalArgumentException();
+        byte[] buffer = new byte[(int)Math.min(n, 4096)];
+        long count = 0;
+        while(count < n){
+            int x = in.read(buffer, 0, (int)Math.min(n - count, buffer.length));
+            if(x == -1) break;
+            count += x;
+        }
+        return count;
+    }
+}
diff --git a/port/web/src/main/java/mindustry/web/WebApplication.java b/port/web/src/main/java/mindustry/web/WebApplication.java
new file mode 100644
index 0000000..e8713b7
--- /dev/null
+++ b/port/web/src/main/java/mindustry/web/WebApplication.java
@@ -0,0 +1,158 @@
+package mindustry.web;
+
+import arc.*;
+import arc.audio.*;
+import arc.func.*;
+import arc.struct.*;
+import arc.util.*;
+import org.teavm.interop.*;
+import org.teavm.jso.*;
+import org.teavm.jso.browser.*;
+
+/** Runs the Arc application loop on requestAnimationFrame. */
+public class WebApplication implements Application{
+    private final Seq<ApplicationListener> listeners = new Seq<>();
+    private final TaskQueue runnables = new TaskQueue();
+    private final Thread mainThread;
+
+    final WebGraphics graphics;
+    final WebInput input;
+    boolean running = true, paused;
+
+    public WebApplication(ApplicationListener listener){
+        listeners.add(listener);
+        mainThread = Thread.currentThread();
+
+        Core.app = this;
+        Core.files = new WebFiles();
+        Core.graphics = graphics = new WebGraphics(WebHost.canvas());
+        Core.input = input = new WebInput(WebHost.canvas(), graphics);
+        Core.settings = new Settings();
+        Core.audio = new Audio(true);
+
+        WebHost.onVisibility(this::visibility);
+    }
+
+    void visibility(boolean visible){
+        if(visible == !paused) return;
+        paused = !visible;
+        if(paused){
+            listen(ApplicationListener::pause);
+            WebLauncher.storage.flush();
+        }else{
+            listen(ApplicationListener::resume);
+        }
+    }
+
+    public void run(){
+        boolean first = true;
+        try{
+            graphics.update();
+            graphics.updateSize();
+            listen(ApplicationListener::init);
+        }catch(Throwable t){
+            running = false;
+            WebHost.crash(t);
+            throw t;
+        }
+
+        while(running){
+            waitFrame();
+            try{
+                frame();
+                if(first){
+                    first = false;
+                    WebHost.ready();
+                }
+            }catch(Throwable t){
+                running = false;
+                WebHost.crash(t);
+                throw t;
+            }
+        }
+        listen(l -> {
+            l.pause();
+            l.dispose();
+        });
+    }
+
+    void frame(){
+        if(graphics.updateSize()){
+            listen(l -> l.resize(graphics.getWidth(), graphics.getHeight()));
+        }
+        graphics.update();
+        input.update();
+        defaultUpdate();
+        listen(ApplicationListener::update);
+        runnables.run();
+        input.postUpdate();
+        WebLauncher.storage.tick();
+        WebMusic.update();
+    }
+
+    @Async
+    static native void waitFrame();
+
+    static void waitFrame(AsyncCallback<Void> callback){
+        Window.requestAnimationFrame(time -> callback.complete(null));
+    }
+
+    private void listen(Cons<ApplicationListener> cons){
+        for(ApplicationListener l : listeners){
+            cons.get(l);
+        }
+    }
+
+    @Override
+    public Seq<ApplicationListener> getListeners(){
+        return listeners;
+    }
+
+    @Override
+    public ApplicationType getType(){
+        return ApplicationType.web;
+    }
+
+    @Override
+    public Thread getMainThread(){
+        return mainThread;
+    }
+
+    @Override
+    public boolean isOnMainThread(){
+        return true;
+    }
+
+    @Override
+    public String getClipboardText(){
+        return WebHost.clipboard;
+    }
+
+    @Override
+    public void setClipboardText(String text){
+        WebHost.clipboard = text;
+        WebHost.writeClipboard(text);
+    }
+
+    @Override
+    public boolean openURI(String uri){
+        if(uri == null || uri.isEmpty()) return false;
+        WebHost.openURI(uri);
+        return true;
+    }
+
+    @Override
+    public void post(Runnable runnable){
+        runnables.post(runnable);
+    }
+
+    @Override
+    public void exit(){
+        //after importing data the game asks to start over: the page restarts it once the files are saved
+        WebLauncher.storage.flush();
+        WebHost.exit();
+    }
+
+    @JSBody(script = "return performance.now();")
+    static native double now();
+}
diff --git a/port/web/src/main/java/mindustry/web/WebFileSystem.java b/port/web/src/main/java/mindustry/web/WebFileSystem.java
new file mode 100644
index 0000000..79143fa
--- /dev/null
+++ b/port/web/src/main/java/mindustry/web/WebFileSystem.java
@@ -0,0 +1,367 @@
+package mindustry.web;
+
+import org.teavm.runtime.fs.*;
+
+import java.io.*;
+import java.util.*;
+
+/**
+ * In-memory file system behind java.io.File. The game's assets are mounted read-only under /assets
+ * straight from the downloaded bundle (no copies); everything under /data is the player's and is
+ * mirrored to IndexedDB by {@link WebStorage}.
+ */
+public class WebFileSystem implements VirtualFileSystem{
+    public static final String dataRoot = "/data";
+    /** Files the game exports land here and are handed to the browser as downloads. */
+    public static final String downloadRoot = "/downloads";
+
+    final Dir root = new Dir("", null);
+    /** Paths under /data written or deleted since the last flush. */
+    final Set<String> dirty = new LinkedHashSet<>();
+
+    public static WebFileSystem install(){
+        WebFileSystem fs = new WebFileSystem();
+        VirtualFileSystemProvider.setInstance(fs);
+        return fs;
+    }
+
+    @Override
+    public String getUserDir(){
+        //code that builds plain internal Fi objects (new Fi("version.properties", internal)) reads relative to here
+        return "/assets";
+    }
+
+    @Override
+    public VirtualFile getFile(String path){
+        return new FileRef(normalize(path));
+    }
+
+    @Override
+    public boolean isWindows(){
+        return false;
+    }
+
+    @Override
+    public String canonicalize(String path){
+        return normalize(path);
+    }
+
+    @Override
+    public String[] getRoots(){
+        return new String[]{"/"};
+    }
+
+    static String normalize(String path){
+        if(path.isEmpty()) return "/";
+        String[] parts = path.split("/");
+        ArrayList<String> out = new ArrayList<>();
+        for(String part : parts){
+            if(part.isEmpty() || part.equals(".")) continue;
+            if(part.equals("..")){
+                if(!out.isEmpty()) out.remove(out.size() - 1);
+            }else{
+                out.add(part);
+            }
+        }
+        StringBuilder b = new StringBuilder();
+        for(String p : out) b.append('/').append(p);
+        return b.length() == 0 ? "/" : b.toString();
+    }
+
+    Node find(String path){
+        if(path.equals("/")) return root;
+        Node node = root;
+        int start = 1;
+        while(node instanceof Dir){
+            int end = path.indexOf('/', start);
+            String name = end < 0 ? path.substring(start) : path.substring(start, end);
+            node = ((Dir)node).children.get(name);
+            if(node == null || end < 0) return node;
+            start = end + 1;
+        }
+        return null;
+    }
+
+    Dir mkdirs(String path){
+        Node node = root;
+        if(path.equals("/")) return root;
+        for(String part : path.substring(1).split("/")){
+            Dir dir = (Dir)node;
+            Node next = dir.children.get(part);
+            if(next == null){
+                next = new Dir(part, dir);
+                dir.children.put(part, next);
+            }
+            node = next;
+        }
+        return (Dir)node;
+    }
+
+    /** Mounts a file without copying it (used for the asset bundle and restored saves). */
+    public void put(String path, byte[] data, int length, long modified, boolean track){
+        path = normalize(path);
+        int slash = path.lastIndexOf('/');
+        Dir dir = mkdirs(slash <= 0 ? "/" : path.substring(0, slash));
+        String name = path.substring(slash + 1);
+        FileNode file = new FileNode(name, dir);
+        file.data = data;
+        file.size = length;
+        file.modified = modified;
+        dir.children.put(name, file);
+        if(track) markDirty(path);
+    }
+
+    void markDirty(String path){
+        if(path.startsWith(dataRoot + "/") || path.startsWith(downloadRoot + "/")) dirty.add(path);
+    }
+
+    public String[] takeDirty(){
+        String[] out = dirty.toArray(new String[0]);
+        dirty.clear();
+        return out;
+    }
+
+    /** @return file contents, or null if the path is not a file. The array may be longer than the file. */
+    public FileNode file(String path){
+        Node node = find(normalize(path));
+        return node instanceof FileNode f ? f : null;
+    }
+
+    static abstract class Node{
+        String name;
+        Dir parent;
+        long modified = System.currentTimeMillis();
+        boolean readOnly;
+
+        Node(String name, Dir parent){
+            this.name = name;
+            this.parent = parent;
+        }
+
+        String path(){
+            if(parent == null) return "/";
+            String p = parent.path();
+            return (p.equals("/") ? "" : p) + "/" + name;
+        }
+    }
+
+    static class Dir extends Node{
+        final LinkedHashMap<String, Node> children = new LinkedHashMap<>();
+
+        Dir(String name, Dir parent){
+            super(name, parent);
+        }
+    }
+
+    public static class FileNode extends Node{
+        public byte[] data = new byte[0];
+        public int size;
+
+        FileNode(String name, Dir parent){
+            super(name, parent);
+        }
+
+        void ensure(int capacity){
+            if(data.length < capacity){
+                data = Arrays.copyOf(data, Math.max(capacity, data.length * 2));
+            }
+        }
+    }
+
+    class FileRef implements VirtualFile{
+        final String path;
+
+        FileRef(String path){
+            this.path = path;
+        }
+
+        @Override
+        public String getName(){
+            return path.substring(path.lastIndexOf('/') + 1);
+        }
+
+        @Override
+        public boolean isDirectory(){
+            return find(path) instanceof Dir;
+        }
+
+        @Override
+        public boolean isFile(){
+            return find(path) instanceof FileNode;
+        }
+
+        @Override
+        public String[] listFiles(){
+            Node node = find(path);
+            if(!(node instanceof Dir dir)) return null;
+            return dir.children.keySet().toArray(new String[0]);
+        }
+
+        @Override
+        public VirtualFileAccessor createAccessor(boolean readable, boolean writable, boolean append){
+            Node node = find(path);
+            if(!(node instanceof FileNode file)) return null;
+            if(writable && file.readOnly) return null;
+            return new Accessor(file, path, append);
+        }
+
+        @Override
+        public boolean createFile(String fileName) throws IOException{
+            Node node = find(path);
+            if(!(node instanceof Dir dir)) throw new IOException("Not a directory: " + path);
+            if(dir.children.containsKey(fileName)) return false;
+            dir.children.put(fileName, new FileNode(fileName, dir));
+            markDirty((path.equals("/") ? "" : path) + "/" + fileName);
+            return true;
+        }
+
+        @Override
+        public boolean createDirectory(String fileName){
+            Node node = find(path);
+            if(!(node instanceof Dir dir) || dir.children.containsKey(fileName)) return false;
+            dir.children.put(fileName, new Dir(fileName, dir));
+            return true;
+        }
+
+        @Override
+        public boolean delete(){
+            Node node = find(path);
+            if(node == null || node.parent == null || node.readOnly) return false;
+            if(node instanceof Dir dir && !dir.children.isEmpty()) return false;
+            node.parent.children.remove(node.name);
+            markDirty(path);
+            return true;
+        }
+
+        @Override
+        public boolean adopt(VirtualFile file, String fileName){
+            Node node = find(path);
+            Node other = find(((FileRef)file).path);
+            if(!(node instanceof Dir dir) || other == null || other.parent == null) return false;
+            String oldPath = other.path();
+            other.parent.children.remove(other.name);
+            other.name = fileName;
+            other.parent = dir;
+            dir.children.put(fileName, other);
+            markTree(oldPath, other);
+            markTree(other.path(), other);
+            return true;
+        }
+
+        void markTree(String at, Node node){
+            markDirty(at);
+            if(node instanceof Dir dir){
+                for(Node child : dir.children.values()){
+                    markTree(at + "/" + child.name, child);
+                }
+            }
+        }
+
+        @Override
+        public boolean canRead(){
+            return find(path) != null;
+        }
+
+        @Override
+        public boolean canWrite(){
+            Node node = find(path);
+            return node != null && !node.readOnly;
+        }
+
+        @Override
+        public long lastModified(){
+            Node node = find(path);
+            return node == null ? 0 : node.modified;
+        }
+
+        @Override
+        public boolean setLastModified(long lastModified){
+            Node node = find(path);
+            if(node == null) return false;
+            node.modified = lastModified;
+            return true;
+        }
+
+        @Override
+        public boolean setReadOnly(boolean readOnly){
+            Node node = find(path);
+            if(node == null) return false;
+            node.readOnly = readOnly;
+            return true;
+        }
+
+        @Override
+        public int length(){
+            Node node = find(path);
+            return node instanceof FileNode f ? f.size : 0;
+        }
+    }
+
+    class Accessor implements VirtualFileAccessor{
+        final FileNode file;
+        final String path;
+        int pos;
+
+        Accessor(FileNode file, String path, boolean append){
+            this.file = file;
+            this.path = path;
+            if(append) pos = file.size;
+        }
+
+        @Override
+        public int read(byte[] buffer, int offset, int limit){
+            int n = Math.min(limit, file.size - pos);
+            if(n <= 0) return -1;
+            System.arraycopy(file.data, pos, buffer, offset, n);
+            pos += n;
+            return n;
+        }
+
+        @Override
+        public void write(byte[] buffer, int offset, int limit){
+            file.ensure(pos + limit);
+            System.arraycopy(buffer, offset, file.data, pos, limit);
+            pos += limit;
+            if(pos > file.size) file.size = pos;
+            file.modified = System.currentTimeMillis();
+            markDirty(path);
+        }
+
+        @Override
+        public int tell(){
+            return pos;
+        }
+
+        @Override
+        public void seek(int target){
+            pos = target;
+        }
+
+        @Override
+        public void skip(int amount){
+            pos += amount;
+        }
+
+        @Override
+        public int size(){
+            return file.size;
+        }
+
+        @Override
+        public void resize(int size){
+            file.ensure(size);
+            if(size > file.size) Arrays.fill(file.data, file.size, size, (byte)0);
+            file.size = size;
+            if(pos > size) pos = size;
+            markDirty(path);
+        }
+
+        @Override
+        public void close(){
+        }
+
+        @Override
+        public void flush(){
+        }
+    }
+}
