@@ -0,0 +1,20 @@
+#include "jni_shim.h"
+
+const char* jni_error = 0;
+int jni_buffer_length = 0;
+JNIEnv jni_env;
+
+extern "C" {
+// the message stays allocated until the next error; errors are rare
+EMSCRIPTEN_KEEPALIVE const char* jni_take_error(){
+    static const char* last = 0;
+    if(last) free((void*)last);
+    last = jni_error;
+    jni_error = 0;
+    return last;
+}
+
+EMSCRIPTEN_KEEPALIVE int jni_buffer_size(){
+    return jni_buffer_length;
+}
+}
diff --git a/port/natives/jni_shim.h b/port/natives/jni_shim.h
new file mode 100644
index 0000000..92f6070
--- /dev/null
+++ b/port/natives/jni_shim.h
@@ -0,0 +1,36 @@
+// Just enough of JNI for the bodies of Arc's natives, compiled for the browser.
+#pragma once
+#include <emscripten.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef int32_t jint;
+typedef intptr_t jlong; // pointers are 32-bit in wasm
+typedef int jboolean;
+typedef float jfloat;
+typedef double jdouble;
+typedef int16_t jshort;
+typedef int8_t jbyte;
+typedef uint16_t jchar;
+typedef void* jobject;
+typedef void* jclass;
+typedef const char* jstring;
+
+extern const char* jni_error;
+extern int jni_buffer_length;
+
+struct JNIEnv{
+    jclass FindClass(const char*){ return (jclass)1; }
+    jint ThrowNew(jclass, const char* message){
+        if(!jni_error) jni_error = strdup(message ? message : "native error");
+        return 0;
+    }
+    jstring NewStringUTF(const char* text){ return text; }
+    jobject NewDirectByteBuffer(void* data, jlong length){
+        jni_buffer_length = (int)length;
+        return data;
+    }
+};
+
+extern JNIEnv jni_env;
