@@ -0,0 +1,108 @@
+package mindustry.web;
+
+import arc.*;
+import arc.util.*;
+import mindustry.*;
+import mindustry.net.*;
+import mindustry.net.Net.*;
+
+public class WebLauncher extends ClientLauncher{
+    static WebFileSystem fs;
+    static WebStorage storage;
+
+    public static void main(String[] args){
+        //read by arc.util.OS; there is no user account or home folder here
+        System.setProperty("user.name", "player");
+        System.setProperty("user.home", WebFileSystem.dataRoot);
+        System.setProperty("java.home", "/java");
+        fs = WebFileSystem.install();
+        storage = new WebStorage(fs);
+        storage.mount();
+
+        mindustry.world.Block.webBuildTypes = WebBuildTypes::get;
+        //touch screens get the game's touch controls and layout
+        Vars.testMobile = touchScreen();
+        WebMusic.install();
+        Log.logger = (level, text) -> WebHost.log("[" + level.name() + "] " + Log.removeColors(text));
+
+        //building the app opens WebGL 2, which can fail before run() reports errors itself
+        WebApplication app;
+        try{
+            app = new WebApplication(new WebLauncher());
+        }catch(Throwable t){
+            WebHost.crash(t);
+            return;
+        }
+        app.run();
+    }
+
+    @Override
+    public void setup(){
+        Core.settings.setDataDirectory(Core.files.absolute(WebFileSystem.dataRoot));
+        super.setup();
+    }
+
+    @org.teavm.jso.JSBody(script = "return matchMedia('(pointer: coarse)').matches;")
+    static native boolean touchScreen();
+
+    /** Saving gives a file that becomes a download; opening asks the browser for one. */
+    @Override
+    public void showFileChooser(mindustry.ui.FileChooser.FileChooserParams params){
+        if(!params.open){
+            arc.files.Fi dir = Core.files.absolute(WebFileSystem.downloadRoot);
+            dir.mkdirs();
+            params.handleChooseResult(dir.child(params.fileName));
+            return;
+        }
+        WebHost.pickFile("." + String.join(",.", params.extensions), (name, data) -> Core.app.post(() -> {
+            arc.files.Fi file = Core.files.absolute("/uploads").child(name);
+            file.writeBytes(data.toJavaArray());
+            params.handleChooseResult(file);
+        }));
+    }
+
+    @Override
+    public NetProvider getNet(){
+        return new OfflineNet();
+    }
+
+    /** No sockets in a browser: hosting and joining games are unavailable. */
+    static class OfflineNet implements NetProvider{
+        @Override
+        public void connectClient(String ip, int port, Runnable success){
+            Vars.net.showError(new RuntimeException("Multiplayer is not available in the browser."));
+        }
+
+        @Override
+        public void sendClient(Object object, boolean reliable){
+        }
+
+        @Override
+        public void disconnectClient(){
+        }
+
+        @Override
+        public void discoverServers(arc.func.Cons<Host> callback, Runnable done){
+            done.run();
+        }
+
+        @Override
+        public void pingHost(String address, int port, arc.func.Cons<Host> valid, arc.func.Cons<Exception> failed){
+            failed.get(new RuntimeException("Multiplayer is not available in the browser."));
+        }
+
+        @Override
+        public void hostServer(int port){
+            throw new RuntimeException("Multiplayer is not available in the browser.");
+        }
+
+        @Override
+        public Iterable<? extends NetConnection> getConnections(){
+            return new arc.struct.Seq<>();
+        }
+
+        @Override
+        public void closeServer(){
+        }
+    }
+}
diff --git a/port/web/src/main/java/mindustry/web/WebMusic.java b/port/web/src/main/java/mindustry/web/WebMusic.java
new file mode 100644
index 0000000..4b285f9
--- /dev/null
+++ b/port/web/src/main/java/mindustry/web/WebMusic.java
@@ -0,0 +1,57 @@
+package mindustry.web;
+
+import arc.audio.*;
+import arc.files.*;
+import arc.struct.*;
+import arc.util.*;
+import org.teavm.jso.*;
+import org.teavm.jso.core.*;
+import org.teavm.jso.typedarrays.*;
+
+/** Music comes in after the game starts (the page downloads it); a track plays once its bytes are in. */
+public class WebMusic{
+    static final IntMap<Music> pending = new IntMap<>();
+    static int lastId;
+
+    interface Loaded extends JSObject{
+        @JSProperty
+        int getId();
+        @JSProperty
+        Int8Array getData();
+    }
+
+    @JSBody(params = {"id", "path"}, script = "window.mindustryHost.fetchLazy(id, path);")
+    static native void fetch(int id, String path);
+
+    @JSBody(script = "return window.mindustryHost.lazyLoaded.splice(0);")
+    static native JSArray<Loaded> poll();
+
+    static void install(){
+        Music.webLoader = (music, file) -> {
+            int id = ++lastId;
+            pending.put(id, music);
+            //internal files are named relative to the asset folder
+            fetch(id, file.path());
+        };
+    }
+
+    /** Called once per frame. */
+    static void update(){
+        if(pending.isEmpty()) return;
+        JSArray<Loaded> loaded = poll();
+        for(int i = 0; i < loaded.getLength(); i++){
+            Loaded l = loaded.get(i);
+            Music music = pending.remove(l.getId());
+            if(music == null) continue;
+            if(l.getData() == null){
+                Log.err("Could not load music: " + music.file);
+                continue;
+            }
+            try{
+                music.load(l.getData().toJavaArray());
+            }catch(Exception e){
+                Log.err("Could not load music: " + music.file, e);
+            }
+        }
+    }
+}
diff --git a/port/web/src/main/java/mindustry/web/WebPlugin.java b/port/web/src/main/java/mindustry/web/WebPlugin.java
new file mode 100644
index 0000000..065df02
--- /dev/null
+++ b/port/web/src/main/java/mindustry/web/WebPlugin.java
@@ -0,0 +1,90 @@
+package mindustry.web;
+
+import org.teavm.model.*;
+import org.teavm.model.emit.*;
+import org.teavm.model.instructions.*;
+import org.teavm.vm.spi.*;
+
+import java.util.*;
+
+/**
+ * Compile-time redirects for JDK methods the browser class library lacks: each call is
+ * rewritten into a static call to {@link Shims}, with the receiver as the first argument.
+ */
+public class WebPlugin implements TeaVMPlugin{
+    static final Map<MethodReference, MethodReference> redirects = new HashMap<>();
+
+    static void redirect(String cls, String name, ValueType ret, ValueType... args){
+        boolean instance = !cls.startsWith("static:");
+        cls = cls.replace("static:", "");
+        ValueType[] shimArgs = args;
+        if(instance){
+            shimArgs = new ValueType[args.length + 1];
+            shimArgs[0] = ValueType.object(cls);
+            System.arraycopy(args, 0, shimArgs, 1, args.length);
+        }
+        ValueType[] from = Arrays.copyOf(args, args.length + 1);
+        from[args.length] = ret;
+        ValueType[] to = Arrays.copyOf(shimArgs, shimArgs.length + 1);
+        to[shimArgs.length] = ret;
+        redirects.put(new MethodReference(cls, name, from), new MethodReference(Shims.class.getName(), name, to));
+    }
+
+    static{
+        ValueType str = ValueType.object("java.lang.String");
+        redirect("java.lang.Class", "isAnonymousClass", ValueType.BOOLEAN);
+        redirect("java.lang.Class", "getResource", ValueType.object("java.net.URL"), str);
+        redirect("java.lang.Runtime", "maxMemory", ValueType.LONG);
+        redirect("arc.files.Fi", "map", ValueType.object("java.nio.ByteBuffer"));
+        redirect("static:java.lang.Thread", "sleep", ValueType.VOID, ValueType.LONG, ValueType.INTEGER);
+        redirect("static:arc.util.Strings", "getStackTrace", str, ValueType.object("java.lang.Throwable"));
+        redirect("java.lang.Throwable", "printStackTrace", ValueType.VOID, ValueType.object("java.io.PrintWriter"));
+    }
+
+    @Override
+    public void install(TeaVMHost host){
+        host.add((ClassHolderTransformer)(cls, context) -> {
+            if(cls.getName().equals(Shims.class.getName())) return;
+            //TeaVM's InflaterInputStream.skip() reads into the buffer that still holds compressed input,
+            //corrupting maps and saves whose chunks get skipped; route it through Shims.inflaterSkip
+            if(cls.getName().endsWith("InflaterInputStream") && (cls.getName().startsWith("java.util.zip.") || cls.getName().startsWith("org.teavm.classlib.java.util.zip."))){
+                MethodHolder skip = cls.getMethod(new MethodDescriptor("skip", ValueType.LONG, ValueType.LONG));
+                if(skip != null){
+                    ProgramEmitter pe = ProgramEmitter.create(skip, context.getHierarchy());
+                    pe.invoke(Shims.class.getName(), "inflaterSkip", ValueType.LONG,
+                        pe.var(0, ValueType.object("java.io.InputStream")), pe.var(1, ValueType.LONG)).returnValue();
+                    System.out.println("[WebPlugin] patched " + cls.getName() + ".skip");
+                }
+            }
+            for(MethodHolder method : cls.getMethods()){
+                //Arc natives with no browser version (Pixmap's stb_image path, env vars) are never taken
+                //here, since ArcNativesLoader.loaded stays false; give them a body that throws
+                if(cls.getName().startsWith("arc.") && method.hasModifier(ElementModifier.NATIVE)
+                    && !method.getName().contains("$js_body$") && method.getAnnotations().get("org.teavm.jso.JSBody") == null){
+                    method.getModifiers().remove(ElementModifier.NATIVE);
+                    ProgramEmitter pe = ProgramEmitter.create(method, context.getHierarchy());
+                    pe.construct(UnsupportedOperationException.class, pe.constant(method.getReference().toString())).raise();
+                    continue;
+                }
+                Program program = method.getProgram();
+                if(program == null) continue;
+                for(BasicBlock block : program.getBasicBlocks()){
+                    for(Instruction insn : block){
+                        if(!(insn instanceof InvokeInstruction invoke)) continue;
+                        MethodReference target = redirects.get(invoke.getMethod());
+                        if(target == null) continue;
+                        if(invoke.getInstance() != null){
+                            List<Variable> args = new ArrayList<>();
+                            args.add(invoke.getInstance());
+                            args.addAll(invoke.getArguments());
+                            invoke.setInstance(null);
+                            invoke.setArguments(args.toArray(new Variable[0]));
+                        }
+                        invoke.setType(InvocationType.SPECIAL);
+                        invoke.setMethod(target);
+                    }
+                }
+            }
+        });
+    }
+}
diff --git a/port/web/src/main/java/mindustry/web/WebReflection.java b/port/web/src/main/java/mindustry/web/WebReflection.java
new file mode 100644
index 0000000..ae1cbfd
--- /dev/null
+++ b/port/web/src/main/java/mindustry/web/WebReflection.java
@@ -0,0 +1,79 @@
+package mindustry.web;
+
+import org.teavm.extension.introspect.*;
+import org.teavm.extension.spi.reflection.*;
+
+import java.lang.reflect.*;
+import java.util.*;
+
+/**
+ * Arc's Json reads and writes fields by reflection (rules, objectives, settings, planet data) and creates
+ * objects with no-arg constructors. Opening every class makes the build run out of memory, so only the
+ * classes Json can reach from what Mindustry serializes get their fields and constructors.
+ */
+public class WebReflection extends SimpleReflectionPolicy{
+    //whole packages holding serialized types, polymorphic ones included (objectives, markers)
+    static final List<String> packages = List.of("mindustry.game.", "mindustry.maps.", "mindustry.io.", "mindustry.mod.", "mindustry.net.");
+    //classes passed to Json in Mindustry's code and settings
+    static final List<String> roots = List.of("mindustry.game.Rules", "mindustry.type.ItemStack", "mindustry.type.LiquidStack",
+        "mindustry.type.PayloadStack", "mindustry.type.ItemSeq", "mindustry.type.Planet$PlanetData", "mindustry.game.SectorInfo",
+        "mindustry.game.CampaignRules", "mindustry.game.GameStats", "mindustry.world.consumers.ConsumeLiquid",
+        "mindustry.mod.Mods$ModMeta", "mindustry.type.MapLocales", "mindustry.audio.MusicContainer",
+        "mindustry.ui.dialogs.MapListDialog$MapViewSettings", "mindustry.ui.dialogs.JoinDialog$Server",
+        "arc.graphics.Color", "arc.math.geom.Vec2", "arc.math.geom.Point2", "arc.math.geom.Rect",
+        "arc.struct.Seq", "arc.struct.IntSeq", "arc.struct.IntMap", "arc.struct.ObjectMap", "arc.struct.ObjectIntMap",
+        "arc.struct.ObjectFloatMap", "arc.struct.ObjectSet", "arc.struct.IntSet", "arc.struct.StringMap", "arc.struct.OrderedMap",
+        "arc.struct.OrderedSet", "arc.struct.ArrayMap", "arc.struct.Queue");
+
+    final Set<String> open = new HashSet<>();
+
+    @Override
+    protected void setup(){
+        IntrospectClass<?> content = environment().findClass("mindustry.ctype.Content");
+        ArrayDeque<IntrospectClass<?>> queue = new ArrayDeque<>();
+        for(String root : roots) queue.add(environment().findClass(root));
+        while(!queue.isEmpty()){
+            IntrospectClass<?> cls = queue.poll();
+            if(cls == null || cls.isPrimitive()) continue;
+            if(cls.isArray()){
+                queue.add(cls.componentType());
+                continue;
+            }
+            String name = cls.name();
+            //content is written by name through custom serializers
+            if(!(name.startsWith("mindustry.") || name.startsWith("arc.")) || content.isAssignableFrom(cls) || !open.add(name)) continue;
+            queue.add(cls.superclass());
+            for(IntrospectField field : cls.declaredFields()){
+                if(!serializable(field)) continue;
+                queue.add(field.type());
+                addTypes(field.genericType(), queue);
+            }
+        }
+
+        System.out.println("[WebReflection] " + open.size() + " classes from roots: " + new TreeSet<>(open));
+        selectClasses(c -> open.contains(c.name()) || packages.stream().anyMatch(p -> c.name().startsWith(p)))
+            .reflectableFields(WebReflection::serializable)
+            .reflectableMethods(m -> m.isConstructor() && m.parameters().isEmpty());
+        //listed with getFields(): UI styles, logic layers, effects
+        selectClasses(c -> statics.contains(c.name())).reflectableFields(f -> Modifier.isStatic(f.modifiers()) && Modifier.isPublic(f.modifiers()));
+    }
+
+    static final List<String> statics = List.of("mindustry.ui.Styles", "mindustry.graphics.Layer", "mindustry.content.Fx");
+
+    static boolean serializable(IntrospectField f){
+        return !Modifier.isStatic(f.modifiers()) && !Modifier.isTransient(f.modifiers());
+    }
+
+    static void addTypes(IntrospectType type, Deque<IntrospectClass<?>> queue){
+        if(type instanceof IntrospectClass<?> c){
+            queue.add(c);
+        }else if(type instanceof IntrospectParameterizedType p){
+            queue.add(p.rawType());
+            for(IntrospectTypeArgument arg : p.typeArguments()){
+                if(arg.type() != null) addTypes(arg.type(), queue);
+            }
+        }else if(type instanceof IntrospectGenericArray a){
+            addTypes(a.componentType(), queue);
+        }
+    }
+}
diff --git a/port/web/src/main/java/mindustry/web/WebStorage.java b/port/web/src/main/java/mindustry/web/WebStorage.java
new file mode 100644
index 0000000..c88bf40
--- /dev/null
+++ b/port/web/src/main/java/mindustry/web/WebStorage.java
@@ -0,0 +1,82 @@
+package mindustry.web;
+
+import org.teavm.jso.*;
+import org.teavm.jso.core.*;
+import org.teavm.jso.typedarrays.*;
+
+/** Mounts the asset bundle and the player's saved files, and writes changed files back to IndexedDB. */
+public class WebStorage{
+    final WebFileSystem fs;
+    double lastFlush;
+
+    WebStorage(WebFileSystem fs){
+        this.fs = fs;
+    }
+
+    interface Entry extends JSObject{
+        @JSProperty
+        String getPath();
+        @JSProperty
+        Int8Array getData();
+        @JSProperty
+        double getModified();
+    }
+
+    @JSBody(script = "var a = window.mindustryHost.assets; window.mindustryHost.assets = null; return a;")
+    static native JSArray<Entry> takeAssets();
+
+    @JSBody(script = "var a = window.mindustryHost.saved; window.mindustryHost.saved = null; return a || [];")
+    static native JSArray<Entry> takeSaved();
+
+    @JSBody(params = {"path", "data", "length", "modified"}, script = "window.mindustryHost.store(path, data.subarray(0, length), modified);")
+    static native void store(String path, @JSByRef byte[] data, int length, double modified);
+
+    @JSBody(params = {"name", "data", "length"}, script = "window.mindustryHost.download(name, data.subarray(0, length));")
+    static native void download(String name, @JSByRef byte[] data, int length);
+
+    @JSBody(params = "path", script = "window.mindustryHost.remove(path);")
+    static native void remove(String path);
+
+    void mount(){
+        JSArray<Entry> assets = takeAssets();
+        for(int i = 0; i < assets.getLength(); i++){
+            Entry e = assets.get(i);
+            byte[] data = e.getData().toJavaArray();
+            fs.put(WebFiles.assetsPath + e.getPath(), data, data.length, 0, false);
+            fs.file(WebFiles.assetsPath + e.getPath()).readOnly = true;
+        }
+        JSArray<Entry> saved = takeSaved();
+        for(int i = 0; i < saved.getLength(); i++){
+            Entry e = saved.get(i);
+            byte[] data = e.getData().toJavaArray();
+            fs.put(e.getPath(), data, data.length, (long)e.getModified(), false);
+        }
+        fs.mkdirs(WebFileSystem.dataRoot);
+    }
+
+    void tick(){
+        double now = WebApplication.now();
+        if(now - lastFlush > 2000){
+            flush();
+        }
+    }
+
+    void flush(){
+        lastFlush = WebApplication.now();
+        if(fs.dirty.isEmpty()) return;
+        for(String path : fs.takeDirty()){
+            WebFileSystem.FileNode node = fs.file(path);
+            if(path.startsWith(WebFileSystem.downloadRoot + "/")){
+                //written in full by now: exports run within one frame
+                if(node != null){
+                    download(path.substring(path.lastIndexOf('/') + 1), node.data, node.size);
+                    arc.Core.files.absolute(path).delete();
+                }
+            }else if(node != null){
+                store(path, node.data, node.size, node.modified);
+            }else if(fs.find(path) == null){
+                remove(path);
+            }
+        }
+    }
+}
diff --git a/port/web/src/main/java/mindustry/web/WebSubstitutions.java b/port/web/src/main/java/mindustry/web/WebSubstitutions.java
